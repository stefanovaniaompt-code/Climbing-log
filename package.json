{
  "name": "climbing-coach-v2-design",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc -b && vite build --configLoader runner",
    "native:sync": "pnpm build && cap sync",
    "native:android": "pnpm native:sync && cap open android",
    "native:ios": "pnpm native:sync && cap open ios",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "encoding:check": "node scripts/check-encoding.mjs",
    "check": "pnpm encoding:check && pnpm copy:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:start": "supabase start",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase test db --local",
    "test:remote:onboarding": "node scripts/verify-remote-onboarding.mjs",
    "snapshot:supabase": "node scripts/snapshot-supabase-project.mjs",
    "snapshot:verify": "node scripts/verify-supabase-snapshot.mjs",
    "preview": "vite preview --configLoader runner",
    "test": "vitest run --configLoader runner && node --test migration/*.test.mjs",
    "migration:dry-run": "node migration/validate-v1.mjs migration/fixtures/legacy-v1.sample.json",
    "copy:check": "node scripts/check-ui-copy.mjs"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "8.3.0",
    "@capacitor/android": "8.5.1",
    "@capacitor/core": "8.5.1",
    "@capacitor/ios": "8.5.1",
    "@supabase/supabase-js": "2.115.0",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "7.18.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "eslint": "10.10.0",
    "supabase": "2.116.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "7.1.7",
    "vitest": "5.0.0"
  }
}
